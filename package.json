{
  "name": "liquid-metal-fluid-gallery",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://soham-tarabada.github.io/liquid_metal_fluid_gallery/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "hdr:inspect": "python3 scripts/hdr-inspect.py",
    "shaders:check": "node scripts/check-shaders.mjs",
    "verify": "npm run typecheck && npm run lint && npm run shaders:check && vite build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-glsl": "^1.6.1"
  }
}
